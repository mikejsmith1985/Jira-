# Jira+ — environment overrides.
#
# Everything here is optional. The setup screen writes the same values to a
# configuration file under your user profile directory, which is the normal
# route. These variables exist so a machine can be configured without opening
# the app, and they take precedence over the file when set.
#
# One credential operates the whole product. There is deliberately no
# Confluence, GitHub, ServiceNow or SharePoint configuration, because setup
# friction was a principal reason the predecessor went unused.

# Base URL of your Jira Data Center instance, no trailing slash.
JIRA_BASE_URL=https://jira.example.com

# A personal access token, sent as `Authorization: Bearer`. Available on Jira
# Data Center from version 8.14. It acts as you, with exactly your own
# permissions — which is why Jira+ needs no administrative rights anywhere.
# Create one under Profile → Personal Access Tokens.
JIRA_PAT=

# Set to "false" only when a corporate proxy re-signs TLS traffic and Node
# rejects the substituted certificate. It lowers a real protection, so leave it
# unset unless connections fail with a certificate error.
TBX_SSL_VERIFY=true

# Port for the local server. 5555 by default.
PORT=5555
