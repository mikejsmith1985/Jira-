{
  "name": "@jira-plus/core",
  "version": "0.1.0",
  "private": true,
  "description": "Every rule in Jira+, compiled once for both the browser and Node so no rule is ever ported twice",
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
